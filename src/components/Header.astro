---
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a href="/" class="site-name">Francesco G. Pontrandolfo</a>
		<div class="nav-links">
			<HeaderLink href="/apps">Apps</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<a href="https://github.com/francescogpontrandolfo" target="_blank" rel="noopener" class="github-link" aria-label="GitHub">
				<svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18">
					<path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
				</svg>
			</a>
		</div>
	</nav>
</header>

<style>
	header {
		background: var(--cream);
		border-bottom: 1px solid rgb(var(--gray-light));
		padding: 0 1.5em;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 680px;
		margin: 0 auto;
		height: 60px;
	}
	.site-name {
		font-family: var(--font-serif);
		font-size: 1.05rem;
		font-weight: 500;
		color: rgb(var(--black));
		text-decoration: none;
		letter-spacing: 0.01em;
	}
	.site-name:hover {
		color: var(--accent);
	}
	.nav-links {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}
	.github-link {
		display: flex;
		align-items: center;
		color: rgb(var(--gray));
		text-decoration: none;
		transition: color 0.15s;
	}
	.github-link:hover {
		color: rgb(var(--black));
	}
</style>
