---
const today = new Date();
---

<footer>
	<span>&copy; {today.getFullYear()} Francesco G. Pontrandolfo</span>
	<a href="https://github.com/francescogpontrandolfo" target="_blank" rel="noopener">GitHub</a>
</footer>

<style>
	footer {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 2rem;
		padding: 2.5em 1em;
		border-top: 1px solid rgb(var(--gray-light));
		color: rgb(var(--gray));
		font-size: 0.8rem;
		letter-spacing: 0.03em;
	}
	footer a {
		color: rgb(var(--gray));
		text-decoration: none;
	}
	footer a:hover {
		color: rgb(var(--black));
	}
</style>
