---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={`${title} — Francesco G. Pontrandolfo`} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<article>
				<header class="post-header">
					<p class="post-meta">
						<FormattedDate date={pubDate} />
						{updatedDate && (
							<span class="updated"> · Updated <FormattedDate date={updatedDate} /></span>
						)}
					</p>
					<h1>{title}</h1>
				</header>
				<div class="prose">
					<slot />
				</div>
			</article>
			<a href="/blog" class="back-link">← All posts</a>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		padding-top: 4em;
		padding-bottom: 4em;
	}
	.post-header {
		margin-bottom: 2.5em;
		padding-bottom: 2em;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.post-meta {
		font-size: 0.8rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: rgb(var(--gray));
		margin-bottom: 0.8em;
	}
	.updated {
		color: rgb(var(--gray));
	}
	.post-header h1 {
		font-size: clamp(2.2rem, 6vw, 3.8rem);
		font-weight: 500;
		line-height: 1.1;
		margin: 0;
	}
	.prose {
		font-size: 1.05rem;
		line-height: 1.85;
		color: rgb(var(--gray-dark));
	}
	.prose :global(h2),
	.prose :global(h3),
	.prose :global(h4) {
		margin-top: 2em;
		color: rgb(var(--black));
	}
	.prose :global(a) {
		color: var(--accent);
	}
	.back-link {
		display: inline-block;
		margin-top: 3em;
		font-size: 0.85rem;
		font-weight: 500;
		letter-spacing: 0.04em;
		color: rgb(var(--gray));
		text-decoration: none;
	}
	.back-link:hover {
		color: var(--accent);
	}
</style>
