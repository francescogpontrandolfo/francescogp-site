---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 4);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>Francesco G. Pontrandolfo</h1>
				<p class="bio">
					Product Manager at <a href="https://alan.com" target="_blank" rel="noopener">Alan</a> in Paris.
					From Puglia. Writing, building, and trying to have fun out there.
				</p>
				</section>

			{posts.length > 0 && (
				<section class="writing">
					<span class="section-label">Recent writing</span>
					<ul>
						{posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									<span class="title">{post.data.title}</span>
									<span class="date"><FormattedDate date={post.data.pubDate} /></span>
								</a>
							</li>
						))}
					</ul>
					<a href="/blog" class="all-link">All posts →</a>
				</section>
			)}
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		padding: 5em 0 1.5em;
	}
	.hero h1 {
		font-size: clamp(2rem, 6vw, 3.5rem);
		font-weight: 500;
		line-height: 1.02;
		letter-spacing: -0.01em;
		margin-bottom: 0.7em;
	}
	.bio {
		font-size: 1rem;
		color: rgb(var(--gray-dark));
		line-height: 1.75;
		max-width: 460px;
		margin-bottom: 2.5em;
	}
	.bio a {
		color: inherit;
		text-decoration-color: rgb(var(--gray-light));
	}
	.bio a:hover {
		color: var(--accent);
		text-decoration-color: var(--accent);
	}
.writing {
		padding: 1.5em 0;
	}
	.section-label {
		display: block;
		font-size: 0.68rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: rgb(var(--gray));
		margin-bottom: 1.5em;
	}
	ul {
		list-style: none;
		padding: 0;
		margin: 0 0 1.5em;
	}
	ul li { border-bottom: 1px solid rgb(var(--gray-light)); }
	ul li:first-child { border-top: 1px solid rgb(var(--gray-light)); }
	ul li a {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		padding: 0.85em 0;
		text-decoration: none;
		color: rgb(var(--black));
	}
	ul li a:hover .title { color: var(--accent); }
	.title { font-size: 0.95rem; }
	.date {
		font-size: 0.75rem;
		color: rgb(var(--gray));
		white-space: nowrap;
		flex-shrink: 0;
	}
	.all-link {
		font-size: 0.8rem;
		font-weight: 500;
		letter-spacing: 0.04em;
		text-decoration: none;
		color: rgb(var(--gray));
	}
	.all-link:hover { color: var(--accent); }

	@media (max-width: 600px) {
		.hero { padding: 3em 0 2.5em; }
		ul li a { flex-direction: column; gap: 0.15em; }
	}
</style>
