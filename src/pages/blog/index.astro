---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Replace with your Buttondown username after signing up at buttondown.email
const BUTTONDOWN_USERNAME = 'francescogp';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Blog — Francesco G. Pontrandolfo" description="Writing about building, reading, and everything in between." />
	</head>
	<body>
		<Header />
		<main>
			<section class="page-header">
				<h1>Blog</h1>
				<p>Writing about building, reading, and everything in between.</p>
			</section>

			<ul class="post-list">
				{posts.map((post) => (
					<li>
						<a href={`/blog/${post.id}/`}>
							<span class="post-title">{post.data.title}</span>
							<span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
						</a>
					</li>
				))}
			</ul>

			<section class="subscribe">
				<p>Get new posts by email — no noise, no spam.</p>
				<form
					action={`https://buttondown.email/api/emails/embed-subscribe/${BUTTONDOWN_USERNAME}`}
					method="post"
					target="popupwindow"
					onsubmit={`window.open('https://buttondown.email/${BUTTONDOWN_USERNAME}', 'popupwindow')`}
				>
					<div class="form-row">
						<input type="email" name="email" placeholder="your@email.com" required />
						<button type="submit">Subscribe</button>
					</div>
				</form>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-header {
		padding: 4em 0 2.5em;
		border-bottom: 1px solid rgb(var(--gray-light));
		margin-bottom: 0;
	}
	.page-header h1 {
		font-size: clamp(2.5rem, 7vw, 4rem);
		margin-bottom: 0.3em;
	}
	.page-header p {
		font-family: var(--font-serif);
		font-style: italic;
		font-size: 1.1rem;
		color: rgb(var(--gray));
		margin: 0;
	}

	.post-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.post-list li { border-bottom: 1px solid rgb(var(--gray-light)); }
	.post-list li a {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		padding: 1em 0;
		text-decoration: none;
		color: rgb(var(--black));
	}
	.post-list li a:hover .post-title { color: var(--accent); }
	.post-title { font-size: 1rem; }
	.post-date {
		font-size: 0.75rem;
		color: rgb(var(--gray));
		white-space: nowrap;
		flex-shrink: 0;
	}

	.subscribe {
		padding: 3em 0 1em;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.subscribe p {
		font-size: 0.9rem;
		color: rgb(var(--gray));
		margin-bottom: 1rem;
	}
	.form-row {
		display: flex;
		gap: 0.5rem;
		max-width: 400px;
	}
	.form-row input[type="email"] {
		flex: 1;
		padding: 0.55em 0.85em;
		font-size: 0.875rem;
		font-family: var(--font-sans);
		background: white;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 5px;
		color: rgb(var(--black));
		outline: none;
		transition: border-color 0.15s;
	}
	.form-row input[type="email"]:focus {
		border-color: rgb(var(--gray));
	}
	.form-row button {
		padding: 0.55em 1.1em;
		font-size: 0.875rem;
		font-family: var(--font-sans);
		font-weight: 500;
		background: rgb(var(--black));
		color: var(--cream);
		border: none;
		border-radius: 5px;
		cursor: pointer;
		transition: opacity 0.15s;
		white-space: nowrap;
	}
	.form-row button:hover { opacity: 0.75; }

	@media (max-width: 600px) {
		.post-list li a { flex-direction: column; gap: 0.15em; }
	}
</style>
