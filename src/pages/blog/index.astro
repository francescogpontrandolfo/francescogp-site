---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Blog — Francesco G. Pontrandolfo" description="Writing about building, reading, and everything in between." />
	</head>
	<body>
		<Header />
		<main>
			<section class="page-header">
				<h1>Blog</h1>
				<p>Writing about building, reading, and everything in between.</p>
			</section>

			<ul class="post-list">
				{posts.map((post) => (
					<li>
						<a href={`/blog/${post.id}/`}>
							<span class="post-title">{post.data.title}</span>
							<span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
						</a>
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-header {
		padding: 4em 0 2.5em;
		border-bottom: 1px solid rgb(var(--gray-light));
		margin-bottom: 0;
	}
	.page-header h1 {
		font-size: clamp(2.5rem, 7vw, 4rem);
		margin-bottom: 0.3em;
	}
	.page-header p {
		font-family: var(--font-serif);
		font-style: italic;
		font-size: 1.15rem;
		color: rgb(var(--gray));
		margin: 0;
	}

	.post-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.post-list li {
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.post-list li a {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		padding: 1em 0;
		text-decoration: none;
		color: rgb(var(--black));
	}
	.post-list li a:hover .post-title {
		color: var(--accent);
	}
	.post-title {
		font-size: 1.05rem;
	}
	.post-date {
		font-size: 0.8rem;
		color: rgb(var(--gray));
		white-space: nowrap;
		flex-shrink: 0;
	}

	@media (max-width: 600px) {
		.post-list li a {
			flex-direction: column;
			gap: 0.15em;
		}
	}
</style>
